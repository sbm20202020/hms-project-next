# Django backend — copy to .env for local development (without Docker)

DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-use-openssl-rand-base64-50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL — set DATABASE_URL to use Postgres instead of the default SQLite
# DATABASE_URL=postgresql://hms:secret@localhost:5432/hms

# In production (DJANGO_ENV=production), DATABASE_URL is mandatory
# DATABASE_SSL_REQUIRE=true
