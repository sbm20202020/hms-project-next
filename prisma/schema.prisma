// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id               Int       @id @default(autoincrement())
  nom              String
  prenom           String
  dateNaissance    DateTime
  age              Int
  sexe             String?
  telephone        String?
  email            String?
  adresse          String?
  ville            String?
  codePostal       String?
  numeroSecu       String?
  typePatient      String?
  convention       String?
  contactUrgence   String?
  telephoneUrgence String?
  allergies        String?
  antecedents      String?
  traitements      String?
  dateCreation     DateTime  @default(now())
  statut           String?
  service          String?
  medecinTraitant  String?
  derniereVisite   DateTime? @default(now())

  dossiers DossierPatient[] // Relation vers DossierPatient
}

model DossierPatient {
  id                Int  @id @default(autoincrement())
  code              String?
  patientId         Int?
  serviceId         Int?
  medecinTraitantId Int?

  motifDeVisite  String?
  niveauUrgence  String? // rendu optionnel pour éviter problème
  statut         String?   @default("attente")
  dateCreation   DateTime  @default(now())
  dateTraitement DateTime?

  patient         Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  service         Service? @relation(fields: [serviceId], references: [id])
  medecinTraitant Employe? @relation(fields: [medecinTraitantId], references: [id])
}

model Log {
  id           Int      @id @default(autoincrement())
  message      String
  type         String // info, warning, error
  modelId      Int
  modelName    String
  action       String // create, update, delete
  userId       Int // user id
  dateCreation DateTime @default(now())
}

model Service {
  id           Int      @id @default(autoincrement())
  nom          String
  description  String?
  statut       String?  @default("Actif")
  dateCreation DateTime @default(now())
  code         String?

  dossiers DossierPatient[]
  employes Employe[]
}

model Role {
  id           Int      @id @default(autoincrement())
  nom          String
  description  String?
  statut       String?  @default("Actif")
  dateCreation DateTime @default(now())

  users           User[]
  rolePermissions RolePermission[]
}

model User {
  id           Int      @id @default(autoincrement())
  roleId       Int
  nom          String
  email        String   @unique
  password     String
  statut       String?  @default("Actif")
  dateCreation DateTime @default(now())

  role    Role     @relation(fields: [roleId], references: [id])
  employe Employe?
}

model Employe {
  id           Int      @id @default(autoincrement())
  userId       Int?     @unique
  nom          String
  prenom       String
  fonction     String // exemple: Médecin, Infirmier, Administratif
  statut       String?  @default("Actif")
  dateCreation DateTime @default(now())
  code         String?
  serviceId    Int?

  dossiers DossierPatient[]
  service Service? @relation(fields: [serviceId], references: [id])
  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Permission {
  id          Int     @id @default(autoincrement())
  nom         String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int?
  permissionId Int?

  role       Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId]) // évite doublons
}
