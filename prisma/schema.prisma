// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id               Int       @id @default(autoincrement())
  typePatient      String?
  convention       String?
  contactUrgence   String?
  telephoneUrgence String?
  allergies        String?
  antecedents      String?
  traitements      String?
  statut           String?
  service          String?
  medecinTraitant  String?
  derniereVisite   DateTime? @default(now())
  dateCreation     DateTime  @default(now())
  contactId        Int?

  dossiers DossierPatient[] // Relation vers DossierPatient
  contact Contact? @relation("PatientContact", fields: [contactId], references: [id])
}

model DossierPatient {
  id                Int  @id @default(autoincrement())
  code              String?
  patientId         Int?
  serviceId         Int?
  medecinTraitantId Int?

  motifDeVisite  String?
  niveauUrgence  String? // rendu optionnel pour éviter problème
  statut         String?   @default("attente")
  dateCreation   DateTime  @default(now())
  dateTraitement DateTime?

  patient         Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  service         Service? @relation(fields: [serviceId], references: [id])
  medecinTraitant Employe? @relation(fields: [medecinTraitantId], references: [id])
  tickets Ticket[]
}

model Ticket {
  id           Int      @id @default(autoincrement())
  code         String?
  dossierPatientId Int?
  dateCreation DateTime @default(now())
  status       String?  @default("attente") // attente, isCalled, invoiced, inProgress, done
  dateCalled   DateTime?
  dateDone     DateTime?

  dossierPatient DossierPatient? @relation(fields: [dossierPatientId], references: [id])
}

