generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organisation {
  id           Int       @id @default(autoincrement())
  nom          String?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  employes     Employe[]
  services     Service[]
  patients     Patient[]
  tickets      Ticket[]
  logs         Log[]
  dossiers     DossierPatient[]
  permissions  Permission[]
  roles        Role[]
  contacts     Contact[]
}

model Patient {
  id               Int       @id @default(autoincrement())
  typePatient      String?
  convention       String?
  contactUrgence   String?
  telephoneUrgence String?
  allergies        String?
  antecedents      String?
  traitements      String?
  statut           String?
  service          String?
  medecinTraitant  String?
  derniereVisite   DateTime? @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contactId        Int?
  organisationId   Int

  dossiers      DossierPatient[]
  contact       Contact?      @relation("PatientContact", fields: [contactId], references: [id])
  organisation  Organisation  @relation(fields: [organisationId], references: [id])
}

model DossierPatient {
  id                Int     @id @default(autoincrement())
  code              String?
  patientId         Int?
  serviceId         Int?
  medecinTraitantId Int?
  organisationId    Int

  motifDeVisite  String?
  niveauUrgence  String?
  statut         String?   @default("attente")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  dateTraitement DateTime?

  patient         Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  service         Service?   @relation(fields: [serviceId], references: [id])
  medecinTraitant Employe?   @relation(fields: [medecinTraitantId], references: [id])
  tickets         Ticket[]   @relation("DossierTickets")
  organisation    Organisation @relation(fields: [organisationId], references: [id])
}

model Ticket {
  id               Int       @id @default(autoincrement())
  code             String?
  dossierPatientId Int?
  organisationId   Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  status           String?   @default("attente")
  dateCalled       DateTime?
  dateDone         DateTime?

  dossierPatient  DossierPatient? @relation("DossierTickets", fields: [dossierPatientId], references: [id])
  organisation    Organisation    @relation(fields: [organisationId], references: [id])
}

model Log {
  id             Int      @id @default(autoincrement())
  message        String
  type           String
  modelId        Int
  modelName      String
  action         String
  userId         Int
  organisationId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

model Service {
  id                          Int      @id @default(autoincrement())
  nom                         String
  description                 String?
  statut                      String?  @default("Actif")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  code                        String?
  organisationId              Int
  isRequiredNurseService      Boolean  @default(false)
  isRequiredDoctorService     Boolean  @default(false)
  isRequiredPharmacistService Boolean  @default(false)
  isRequiredLabService        Boolean  @default(false)
  isRequiredRadiologyService  Boolean  @default(false)
  isRequiredImagingService    Boolean  @default(false)

  dossiers      DossierPatient[]
  employes      Employe[]
  organisation  Organisation @relation(fields: [organisationId], references: [id])
}

model Employe {
  id             Int      @id @default(autoincrement())
  statut         String?  @default("Actif")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  serviceId      Int?
  contactId      Int?
  organisationId Int

  dossiers      DossierPatient[]
  service       Service?        @relation(fields: [serviceId], references: [id])
  contact       Contact?        @relation("EmployeContact", fields: [contactId], references: [id])
  organisation  Organisation    @relation(fields: [organisationId], references: [id])
}

model Contact {
  id                Int       @id @default(autoincrement())
  nom               String?
  prenom            String?
  email             String?
  telephone         String?
  dateNaissance     DateTime?
  age               Int?
  sexe              String?
  adresse           String?
  ville             String?
  codePostal        String?
  numeroSecu        String?
  establishmentType String?
  organization      String?
  position          String?
  isDemoRequest     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  employes          Employe[] @relation("EmployeContact")
  patients          Patient[] @relation("PatientContact")
  users             User[]    @relation("UserContact")

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model Role {
  id             Int      @id @default(autoincrement())
  nom            String
  description    String?
  statut         String?  @default("Actif")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[] @relation("UserRole")
  rolePermissions RolePermission[]

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model Fonction {
  id           Int      @id @default(autoincrement())
  nom          String   @unique
  code         String   @unique
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  permissions  Permission[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  name        String
  statut      String? @default("Actif")
  canCreate      Boolean @default(false)
  canRead        Boolean @default(false)
  canUpdate      Boolean @default(false)
  canDelete      Boolean @default(false)

  fonctionId  Int?
  fonction    Fonction? @relation(fields: [fonctionId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roles       RolePermission[]

  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model RolePermission {
  id           Int  @id @default(autoincrement())
  roleId       Int?
  permissionId Int?

  role       Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccessType {
  DEMO_ADMIN_GUEST
  PRO_ADMIN_GUEST
  DEMO_ADMIN_EXPIRED
  PRO_ADMIN_EXPIRED
  ADMIN_GLOBAL_HMS
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  password       String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accessType     AccessType @default(DEMO_ADMIN_GUEST)
  accounts       Account[]
  sessions       Session[]

  roleId         Int?
  role           Role?        @relation("UserRole", fields: [roleId], references: [id], onDelete: SetNull)
  contactId      Int?
  contact        Contact?     @relation("UserContact", fields: [contactId], references: [id], onDelete: SetNull)
  organisationId Int
  organisation   Organisation @relation(fields: [organisationId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
