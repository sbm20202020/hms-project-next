model Log {
  id           Int      @id @default(autoincrement())
  message      String
  type         String // info, warning, error
  modelId      Int
  modelName    String
  action       String // create, update, delete
  userId       Int // user id
  dateCreation DateTime @default(now())
}

model Service {
  id           Int      @id @default(autoincrement())
  nom          String
  description  String?
  statut       String?  @default("Actif")
  dateCreation DateTime @default(now())
  code         String?
  isRequiredNurseService Boolean @default(false)
  isRequiredDoctorService Boolean @default(false)
  isRequiredPharmacistService Boolean @default(false)
  isRequiredLabService Boolean @default(false)
  isRequiredRadiologyService Boolean @default(false)
  isRequiredImagingService Boolean @default(false)

  dossiers DossierPatient[]
  employes Employe[]
}

model Employe {
  id           Int      @id @default(autoincrement())
  // userId       Int?     @unique
  statut       String?  @default("Actif")
  dateCreation DateTime @default(now())
  serviceId    Int?
  contactId    Int?

  dossiers DossierPatient[]
  service Service? @relation(fields: [serviceId], references: [id])
  // user     User?   @relation("UserEmploye", fields: [userId], references: [id], onDelete: SetNull)
  contact  Contact? @relation("EmployeContact", fields: [contactId], references: [id])
}

model Contact {
  id           Int      @id @default(autoincrement())
  nom          String?
  prenom      String?
  email        String?
  telephone    String?
  dateNaissance    DateTime?
  age              Int?
  sexe             String?
  adresse          String?
  ville            String?
  codePostal       String?
  numeroSecu       String?
  establishmentType String?
  organization String?
  position String?
  isDemoRequest Boolean @default(false)

  dateCreation DateTime @default(now())

  // users    User[]    @relation("UserContact")
  employes Employe[] @relation("EmployeContact")
  patients Patient[] @relation("PatientContact")
  users User[] @relation("UserContact")

}

model Role {
  id           Int      @id @default(autoincrement())
  nom          String   @unique
  description  String?
  statut       String?  @default("Actif")
  dateCreation DateTime @default(now())

  rolePermissions RolePermission[]
}

model Permission {
  id          Int     @id @default(autoincrement())
  nom         String  @unique
  description String?
  code        String?

  roles RolePermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int?
  permissionId Int?

  role       Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permission Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId]) // évite doublons
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccessType {
  DEMO_GUEST
  PRO_GUEST
  DEMO_EXPIRED
  PRO_EXPIRED
  ADMIN_GLOBAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider
  accessType    AccessType @default(DEMO_GUEST)
  accounts      Account[]
  sessions      Session[]

  contactId Int?
  contact Contact? @relation("UserContact", fields: [contactId], references: [id], onDelete: SetNull)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}