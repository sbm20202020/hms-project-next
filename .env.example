# ── Root .env.example — Docker Compose variables ────────────────────────────
# Copy to .env and fill in all values before running `docker compose up`
#
# ── Production / HTTPS deployments (e.g. https://yourdomain.com) ───────────
# Make sure to override the localhost defaults below with your real domain:
#
#   NEXTAUTH_URL=https://yourdomain.com
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,yourdomain.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
#   CORS_ALLOWED_ORIGINS=https://yourdomain.com
#
# Mismatching NEXTAUTH_URL (e.g. http://localhost) on an HTTPS site causes
# NextAuth to use the wrong cookie name, making getToken() always return null
# → redirect loops (ERR_TOO_MANY_REDIRECTS) on every page load.
# ────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=change-me-strong-password

# ── Django backend ──────────────────────────────────────────────────────────
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-use-openssl-rand-base64-50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# DATABASE_URL is built automatically by docker-compose from the Postgres vars

# ── Next.js frontend ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-use-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Ports (optional — change to avoid conflicts) ────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
